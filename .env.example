# =====================================================================
# Smart Fitness & Meal Notification System - Configuration (.env)
# المنطقة الزمنية الافتراضية: توقيت القاهرة (Africa/Cairo - UTC+2)
# =====================================================================

# 1. إعدادات الخادم والبيئة
TIMEZONE=Africa/Cairo
PORT=8000
HOST=0.0.0.0
WEB_BASE_URL=http://localhost:8000

# 2. إعدادات بوت التيليجرام (القناة الأساسية)
# احصل على التوكن من @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# معرف الشات الخاص بك (يمكن للنظام التعرف عليه تلقائياً عند إرسال /start للبوت)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
# تفعيل/تعطيل إشعارات التيليجرام (True/False)
ENABLE_TELEGRAM=True

# 3. إعدادات واتساب عبر CallMeBot (القناة الإضافية / الاختيارية)
# احصل على الـ API Key مجاناً بمراسلة الرقم الرسمي لـ CallMeBot
ENABLE_WHATSAPP=False
CALLMEBOT_PHONE=+201000000000
CALLMEBOT_API_KEY=YOUR_CALLMEBOT_API_KEY_HERE
